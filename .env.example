# Frontend
# Leave blank in local development because Vite proxies /api to localhost:4001.
VITE_API_BASE_URL=

# Backend
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / Neon / Render Postgres / Supabase Postgres connection URL
WEBSITE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# SMTP email provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM_NAME=Bispun
EMAIL_FROM_ADDRESS=noreply@example.com

# Receives new signup and demo notifications
ADMIN_NOTIFICATION_EMAIL=sales@example.com
